<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- 私有目录照片（getExternalFilesDir()/photos/） -->
    <external-files-path
        name="photos"
        path="photos/" />

    <!-- 缩略图目录（getExternalFilesDir()/thumbnails/） -->
    <external-files-path
        name="thumbnails"
        path="thumbnails/" />

    <!-- 导出文件目录（getExternalFilesDir()/reports/，用于 PDF/ZIP 导出后 ACTION_SEND 分享） -->
    <external-files-path
        name="reports"
        path="reports/" />

    <!-- 日志目录（getFilesDir()/logs/，用于 app.log 通过 ACTION_SEND 分享） -->
    <files-path
        name="logs"
        path="logs/" />

    <!-- 临时目录 -->
    <cache-path
        name="cache"
        path="." />
</paths>
